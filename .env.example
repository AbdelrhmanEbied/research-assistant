# LLM — used as bootstrap defaults, overridable from the Settings page
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_PROVIDER=google_genai

# Web search
TAVILY_API_KEY=

# Telemetry
TELEMETRY_ENABLED=true
TELEMETRY_DB_PATH=telemetry.db
ENVIRONMENT=development
APP_VERSION=0.1.0